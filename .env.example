# Asset configuration
ASSET_SYMBOL=BTC-USD
ASSET_QUERY=BTC OR Bitcoin OR $BTC

# Historical price settings
LOOKBACK_DAYS=180
PRICE_INTERVAL=1d

# Apify configuration
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=your_apify_actor_id_here
APIFY_MAX_ITEMS=10000

# Tavily configuration
# Optional if news retrieval is disabled
TAVILY_API_KEY=your_tavily_api_key_here

# Local file and storage paths
HISTORICAL_POSTS_PATH=data/historical_posts.csv
DATABASE_PATH=data/pipeline.db
OUTPUT_DIR=outputs
